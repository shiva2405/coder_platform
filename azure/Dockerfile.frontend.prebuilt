# SimplyCode Frontend Dockerfile (pre-built assets)
# This version uses pre-built dist files - no build step needed

FROM nginx:alpine

# Install gettext for envsubst (runtime config)
RUN apk add --no-cache gettext

# Copy nginx config
COPY azure/nginx.azure.conf /etc/nginx/conf.d/default.conf

# Copy pre-built frontend files
COPY frontend/dist /usr/share/nginx/html

# Create runtime config script for API URL (append /api to backend URL)
RUN echo '#!/bin/sh' > /docker-entrypoint.d/40-configure-api.sh && \
    echo 'if [ -n "$BACKEND_URL" ]; then' >> /docker-entrypoint.d/40-configure-api.sh && \
    echo '  echo "window.SIMPLYCODE_CONFIG = { apiUrl: \"${BACKEND_URL}/api\" };" > /usr/share/nginx/html/config.js' >> /docker-entrypoint.d/40-configure-api.sh && \
    echo 'fi' >> /docker-entrypoint.d/40-configure-api.sh && \
    chmod +x /docker-entrypoint.d/40-configure-api.sh

# Expose port
EXPOSE 80

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
