# SimplyCode Frontend Dockerfile for Azure
# This version configures the API URL at runtime

FROM node:20-alpine AS builder

WORKDIR /app

# Copy package files
COPY frontend/package*.json ./

# Install dependencies
RUN npm ci

# Copy source code
COPY frontend/ .

# Build with production API URL placeholder
ENV VITE_API_URL=/api
RUN npm run build

# Production image
FROM nginx:alpine

# Install envsubst for runtime config
RUN apk add --no-cache gettext

# Copy nginx config
COPY azure/nginx.azure.conf /etc/nginx/conf.d/default.conf

# Copy built files
COPY --from=builder /app/dist /usr/share/nginx/html

# Create runtime config script
RUN echo '#!/bin/sh' > /docker-entrypoint.d/40-configure-api.sh && \
    echo 'if [ -n "$BACKEND_URL" ]; then' >> /docker-entrypoint.d/40-configure-api.sh && \
    echo '  echo "window.SIMPLYCODE_CONFIG = { apiUrl: \"$BACKEND_URL\" };" > /usr/share/nginx/html/config.js' >> /docker-entrypoint.d/40-configure-api.sh && \
    echo 'fi' >> /docker-entrypoint.d/40-configure-api.sh && \
    chmod +x /docker-entrypoint.d/40-configure-api.sh

# Expose port
EXPOSE 80

# Start nginx
CMD ["nginx", "-g", "daemon off;"]
