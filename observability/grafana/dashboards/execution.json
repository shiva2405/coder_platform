      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(coder_execution_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(coder_execution_duration_seconds_bucket[5m])) by (le))",
